# Environment variables for Docker container and docker-compose.yml
# Used by run.sh for model validation and server configuration

# Model configuration
MODEL_NAME=Qwen3.6-35B-A3B-UD-Q4_K_XL
MODEL_NAME_ALIAS=qwen3.6-35b
HF_REPO=unsloth/Qwen3.6-35B-A3B-UD-GGUF
CTX_SIZE=98304
FLASH_ATTN=on
THREADS=5
BATCH_SIZE=256
CACHE_TYPE_K=q4_0
CACHE_TYPE_V=q4_0
NO_MMAP=false
PARALLEL=1
CACHE_RAM=4096

# Fit / speculative decoding
FIT=on
FIT_TARGET=256
FIT_CTX=98304
UBATCH_SIZE=256
POLL_BATCH=0

# Sampling
TEMP=0.6
TOP_P=0.95
TOP_K=20
MIN_P=0.0

# Penalties
PRESENCE_PENALTY=0.0
REPEAT_PENALTY=1.0

# Features
REASONING=on

# Jinja chat template (leave empty to use model's built-in template)
CHAT_TEMPLATE=/app/qwen_chat_template.jinja

# Server configuration
HOST=0.0.0.0
PORT_INTERNAL=8080
PORT_EXTERNAL=8001

# Hardware: force CPU even if NVIDIA GPU is available (on/off)
FORCE_CPU=off

# SearXNG secret (auto-generated on first run if empty)
SEARXNG_SECRET=

# Embeddings (llama.cpp --embeddings instance)
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0          # .gguf filename (no ext)
EMBEDDING_HF_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBEDDING_CTX=8192
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=8192
EMBEDDING_DIM=1024

# RAG service
RAG_PORT_INTERNAL=8083
RAG_PORT_EXTERNAL=8002
RAG_EMBED_BATCH=8          # chunks per embedding request (stay under ctx=8192)
RAG_CHUNK_WORDS=600         # target chunk size
RAG_CHUNK_OVERLAP=100
RAG_MAX_CRAWL_PAGES=10      # pages crawled when /ingest/url depth >= 1
RAG_FETCH_TIMEOUT=30        # per-URL fetch timeout (seconds)

# Qdrant (host access optional)
QDRANT_PORT=6333
