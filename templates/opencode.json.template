{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://localhost:{{PORT_EXTERNAL}}/v1"
      },
      "models": {
        "{{MODEL_NAME}}": {
          "name": "{{MODEL_NAME_ALIAS}}"
        }
      }
    }
  },

  "model": "llamacpp/{{MODEL_NAME}}",

  "disabled_providers": [
    "openai",
    "anthropic",
    "google",
    "groq",
    "openrouter"
  ],

  "mcp": {
    "fetch": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "mcp/fetch"]
    },
    "searxng-search": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "--network", "lechatonfat_default", "lechatonfat-searxng-mcp"]
    },
    "browser": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "--network", "lechatonfat_default", "lechatonfat-mcp-browser"]
    },
    "rag": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "--network", "lechatonfat_default", "lechatonfat-mcp-rag"]
    }
  }
}